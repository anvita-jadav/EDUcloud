# EduCloude backend configuration
# Firebase Admin service account
# 1) Firebase console > Project settings > Service accounts > Generate new private key
# 2) Download the JSON and save it in this folder
FIREBASE_PROJECT_ID=educloud-f42a0
FIREBASE_SERVICE_ACCOUNT_PATH=./educloud-f42a0-firebase-adminsdk-fbsvc-61ae551e96.json
# On Render, either keep the path above OR set the base64-encoded JSON here:
#   cat educloud-...json | base64 -w0
FIREBASE_SERVICE_ACCOUNT_B64=

# Comma-separated allowed frontend origins (no trailing slash)
# The backend ALSO allows any https://*.onrender.com origin by regex, so a
# Render-hosted frontend works even if this env var is out of date.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,https://educloude-frontend.onrender.com

# Used to sign attendance QR tokens. Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
# If unset, a random key is generated at startup (QRs invalidate on restart).
# SECRET_KEY=

# Fixed admin account (username: jadav / password: EDUcloud@987)
ADMIN_USERNAME=jadav
ADMIN_PASSWORD=EDUcloud@987

# Gemini API key for the EDUtech AI chatbot
# GEMINI_API_KEY=